# El entorno virtual local no debe entrar a la imagen: la imagen instala sus
# propias dependencias para la arquitectura del contenedor.
.venv/
venv/

.git/
.gitignore

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Los secretos se inyectan en tiempo de ejecucion, nunca se hornean en la imagen.
.env

.DS_Store
*.log
# The API image does not need the frontend: it has its own image. Only the
# nginx config is kept, because tests/test_deploy_constraints.py checks that the
# SSE location does not buffer.
frontend/
!frontend/nginx.conf
# The AI service has its own image (ml/Dockerfile).
ml/
