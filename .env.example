# Copiar a .env y ajustar. El archivo .env nunca se versiona.
#
# Al ejecutar con Docker Compose, las variables DATABASE_URL y FHIR_BASE_URL se
# sobrescriben automaticamente para apuntar a los servicios internos (db, hapi).
# Los valores de abajo aplican cuando se ejecuta la API directamente en la
# maquina, fuera de contenedores.

# ---------------------------------------------------------------------------
# Base de datos de la aplicacion
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://saludred:saludred@localhost:5433/saludred

# Credenciales del contenedor de PostgreSQL (usadas por Docker Compose).
POSTGRES_USER=saludred
POSTGRES_PASSWORD=saludred
POSTGRES_DB=saludred

# ---------------------------------------------------------------------------
# Autenticacion
# ---------------------------------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambiar-antes-de-ejecutar-minimo-16-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Servidor HAPI FHIR R4
# ---------------------------------------------------------------------------
FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_IDENTIFIER_SYSTEM=urn:saludred:identifier
FHIR_REQUEST_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Ejecucion
# ---------------------------------------------------------------------------
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Carga datos sinteticos al arrancar el contenedor. Si la base ya tiene datos,
# el seed se omite solo: reiniciar nunca duplica ni borra informacion.
SEED_ON_START=true
SEED_DEFAULT_PASSWORD=Demo2026!
