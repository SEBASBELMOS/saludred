# ---------------------------------------------------------------------------
# Application database (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Format: postgresql+psycopg://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@ep-example.us-east-2.aws.neon.tech/saludred?sslmode=require

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-before-running
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# HAPI FHIR R4 server
# ---------------------------------------------------------------------------
FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_IDENTIFIER_SYSTEM=urn:saludred:identifier
FHIR_REQUEST_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SEED_DEFAULT_PASSWORD=Demo2026!
